# Core defaults
CHAT_URL=https://simplechatdemo-fjgpaqe7h6c7akbr.eastus-01.azurewebsites.net/chats
OUTPUT_DIR=outputs
STATE_FILE=.auth/storage-state.json
NETWORK_TEMPLATE=outputs/network-log-ui-full.json
SELECTORS_PATH=selectors.example.json
FOUNDRY_EXPORT_DIR=foundry_exports

# Wizard/server binding
HOST=127.0.0.1
PORT=5088

# Execution defaults
TIMEOUT_MS=45000
WAIT_MS=500
HEADED=true
NEW_CHAT=false
DEBUG_NETWORK=false

# Generic API mode defaults
API_URL=
API_METHOD=POST
API_RESPONSE_PATH=choices.0.message.content

# JSONL output options
INCLUDE_GROUND_TRUTH=true
INCLUDE_CONTEXT=false
INCLUDE_METADATA=false
STRICT_SCHEMA=false
MASK_LOGS=true

# JSONL profile and custom keys
JSONL_PROFILE=foundry-basic
JSONL_QUERY_KEY=query
JSONL_RESPONSE_KEY=response
JSONL_GROUND_TRUTH_KEY=ground_truth
JSONL_CONTEXT_KEY=context
